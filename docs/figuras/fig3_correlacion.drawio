        <mxCell id="col_logs" value="1. LOGS ESTRUCTURADOS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fb;strokeColor=#1a5fb4;strokeWidth=2;verticalAlign=top;align=center;fontSize=15;fontStyle=1;fontColor=#1a5fb4;arcSize=6;spacingTop=4;container=1;collapsible=0;" parent="1" vertex="1">
          <mxGeometry x="30" y="190" width="430" height="480" as="geometry" />
