        <mxCell id="c2" value="Una sola peticion de compra, capturada en el entorno de pruebas. Los tres bloques comparten el mismo identificador." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontSize=11.5;fontColor=#555555;fontStyle=0" parent="1" vertex="1">
          <mxGeometry x="30" y="40" width="1200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="pivote" value="&lt;b&gt;trace_id&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-family: Consolas, monospace; font-size: 14px&#39;&gt;aef4e2c82298fb222f881f25b2383bd3&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdeceb;strokeColor=#c0392b;strokeWidth=3;align=center;verticalAlign=middle;fontSize=13;fontColor=#8b2520;arcSize=10;" parent="1" vertex="1">
