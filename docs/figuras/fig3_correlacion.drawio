        </mxCell>
        <mxCell id="c25" value="&lt;b&gt;Atributos del span de negocio&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-family: Consolas, monospace; font-size: 10px&#39;&gt;ecommerce.order.id = ord-10dc0f85abb5&lt;br&gt;ecommerce.customer.tier = silver&lt;br&gt;ecommerce.payment.result = authorized&lt;br&gt;ecommerce.checkout.step = order_submit&lt;br&gt;enduser.id = cli-007&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c6b9e0;verticalAlign=top;align=left;fontSize=10;arcSize=8;spacingLeft=8;spacingTop=4;spacingRight=6;fontColor=#333333;" parent="col_trazas" vertex="1">
          <mxGeometry x="14" y="252" width="402" height="116" as="geometry" />
        </mxCell>
        <mxCell id="c26" value="&lt;b&gt;Como se logra&lt;/b&gt;&lt;br&gt;&lt;br&gt;service-a envia la cabecera traceparent del W3C y service-b la lee, asi que no crea una traza nueva.&lt;br&gt;&lt;i&gt;TraceContextTextMapPropagator + HTTPXClientInstrumentor&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0ecf9;strokeColor=#7a5cc4;verticalAlign=top;align=left;fontSize=10;arcSize=8;spacingLeft=8;spacingTop=4;spacingRight=6;fontColor=#333333;dashed=1;" parent="col_trazas" vertex="1">
          <mxGeometry x="14" y="380" width="402" height="86" as="geometry" />
        </mxCell>
        <mxCell id="col_metricas" value="3. METRICAS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2faf5;strokeColor=#1f6b41;strokeWidth=2;verticalAlign=top;align=center;fontSize=15;fontStyle=1;fontColor=#1f6b41;arcSize=6;spacingTop=4;container=1;collapsible=0;" parent="1" vertex="1">
          <mxGeometry x="970" y="190" width="480" height="480" as="geometry" />
        </mxCell>
        <mxCell id="c27" value="formato Prometheus en :9464/metrics" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontSize=10;fontColor=#555555;fontStyle=0" parent="col_metricas" vertex="1">
          <mxGeometry x="14" y="26" width="452" height="16" as="geometry" />
        </mxCell>
        <mxCell id="c28" value="&lt;b&gt;De negocio, escritas a mano&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-family: Consolas, monospace; font-size: 10px&#39;&gt;ecommerce_orders_created_total&lt;br&gt;ecommerce_checkout_duration_seconds&lt;br&gt;ecommerce_order_amount&lt;br&gt;inventory_reservations_total&lt;br&gt;inventory_reserve_duration_seconds&lt;br&gt;inventory_stock_level&lt;/font&gt;&lt;br&gt;&lt;i&gt;37 series verificadas en el endpoint&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a8d6bd;verticalAlign=top;align=left;fontSize=10;arcSize=8;spacingLeft=8;spacingTop=4;spacingRight=6;fontColor=#333333;" parent="col_metricas" vertex="1">
          <mxGeometry x="14" y="50" width="452" height="140" as="geometry" />
        </mxCell>
        <mxCell id="c29" value="&lt;b&gt;Derivadas de los spans por el Collector&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-family: Consolas, monospace; font-size: 10px&#39;&gt;otel_demo_calls_total&lt;br&gt;otel_demo_duration_milliseconds_bucket&lt;/font&gt;&lt;br&gt;&lt;br&gt;Salen del conector spanmetrics, o sea del 100% de los spans. Alimentan los SLI." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a8d6bd;verticalAlign=top;align=left;fontSize=10;arcSize=8;spacingLeft=8;spacingTop=4;spacingRight=6;fontColor=#333333;" parent="col_metricas" vertex="1">
          <mxGeometry x="14" y="204" width="452" height="106" as="geometry" />
        </mxCell>
        <mxCell id="c30" value="&lt;b&gt;El puente hacia las trazas&lt;/b&gt;&lt;br&gt;&lt;br&gt;Las metricas no llevan trace_id porque serian de cardinalidad infinita. El enlace se hace por dos vias:&lt;br&gt;&amp;#8226; atributos de recurso comunes (service.name)&lt;br&gt;&amp;#8226; exemplars, que si guardan un trace_id de ejemplo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf6ef;strokeColor=#2e9e63;verticalAlign=top;align=left;fontSize=10;arcSize=8;spacingLeft=8;spacingTop=4;spacingRight=6;fontColor=#333333;dashed=1;" parent="col_metricas" vertex="1">
          <mxGeometry x="14" y="324" width="452" height="132" as="geometry" />
        </mxCell>
        <mxCell id="flujo" value="Recorrido de una alerta" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#666666;strokeWidth=2;verticalAlign=top;align=center;fontSize=13;fontStyle=1;fontColor=#666666;arcSize=6;spacingTop=4;container=1;collapsible=0;" parent="1" vertex="1">
          <mxGeometry x="30" y="700" width="1420" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="&lt;b style=&quot;font-size: 15px;&quot;&gt;1. Salta una alerta&lt;/b&gt;&lt;br style=&quot;font-size: 15px;&quot;&gt;&lt;br style=&quot;font-size: 15px;&quot;&gt;El panel de latencia p99 supera el umbral. Viene de metricas, que se calculan sobre todo." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;align=left;fontSize=15;arcSize=8;spacingLeft=8;spacingTop=4;spacingRight=6;" parent="flujo" vertex="1">
          <mxGeometry x="16" y="36" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="&lt;b style=&quot;font-size: 15px;&quot;&gt;2. Abre un ejemplo&lt;/b&gt;&lt;br style=&quot;font-size: 15px;&quot;&gt;&lt;br style=&quot;font-size: 15px;&quot;&gt;El exemplar del histograma lleva a una traza concreta de las que superaron el umbral." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;align=left;fontSize=15;arcSize=8;spacingLeft=8;spacingTop=4;spacingRight=6;" parent="flujo" vertex="1">
          <mxGeometry x="298" y="36" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="&lt;b style=&quot;font-size: 15px;&quot;&gt;3. Ve donde se fue el tiempo&lt;/b&gt;&lt;br style=&quot;font-size: 15px;&quot;&gt;&lt;br style=&quot;font-size: 15px;&quot;&gt;La cascada muestra que el 56% del tiempo esta en la llamada a service-b." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;align=left;fontSize=15;arcSize=8;spacingLeft=8;spacingTop=4;spacingRight=6;" parent="flujo" vertex="1">
          <mxGeometry x="580" y="36" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="&lt;b style=&quot;font-size: 15px;&quot;&gt;4. Lee los logs de esa traza&lt;/b&gt;&lt;br style=&quot;font-size: 15px;&quot;&gt;&lt;br style=&quot;font-size: 15px;&quot;&gt;Un clic filtra los logs por trace_id y muestra las 5 lineas de esa peticion." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;align=left;fontSize=15;arcSize=8;spacingLeft=8;spacingTop=4;spacingRight=6;" parent="flujo" vertex="1">
          <mxGeometry x="862" y="36" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p5" value="&lt;b style=&quot;font-size: 15px;&quot;&gt;5. Causa identificada&lt;/b&gt;&lt;br style=&quot;font-size: 15px;&quot;&gt;&lt;br style=&quot;font-size: 15px;&quot;&gt;Sin cambiar de herramienta ni buscar a mano por marca de tiempo." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;align=left;fontSize=15;arcSize=8;spacingLeft=8;spacingTop=4;spacingRight=6;" parent="flujo" vertex="1">
          <mxGeometry x="1144" y="36" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="f31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d6b656;strokeWidth=2;endArrow=block;endFill=1;fontSize=15;fontColor=#c0392b;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#fff2cc;" parent="1" source="p1" target="p2" edge="1">
