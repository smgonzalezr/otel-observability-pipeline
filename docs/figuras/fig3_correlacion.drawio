        <mxCell id="c3" value="salida estandar en JSON, sin campos libres" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontSize=10;fontColor=#555555;fontStyle=0" parent="col_logs" vertex="1">
          <mxGeometry x="14" y="26" width="402" height="16" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;font style=&#39;font-family: Consolas, monospace; font-size: 10px&#39;&gt;{&quot;timestamp&quot;: &quot;...&quot;, &quot;severity&quot;: &quot;INFO&quot;,&lt;br&gt;&amp;#160;&quot;message&quot;: &quot;checkout iniciado&quot;,&lt;br&gt;&amp;#160;&quot;service.name&quot;: &quot;service-a&quot;,&lt;br&gt;&lt;font color=&#39;#c0392b&#39;&gt;&amp;#160;&quot;trace_id&quot;: &quot;aef4e2c822...83bd3&quot;,&lt;/font&gt;&lt;br&gt;&lt;font color=&#39;#c0392b&#39;&gt;&amp;#160;&quot;span_id&quot;: &quot;b36bf8543506e168&quot;,&lt;/font&gt;&lt;br&gt;&amp;#160;&quot;ecommerce.order.id&quot;: &quot;ord-10dc0f85abb5&quot;}&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9cfe6;verticalAlign=top;align=left;fontSize=10;arcSize=8;spacingLeft=8;spacingTop=4;spacingRight=6;fontColor=#333333;" parent="col_logs" vertex="1">
          <mxGeometry x="14" y="50" width="402" height="122" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;b&gt;Las 5 lineas de esta peticion&lt;/b&gt;&lt;br&gt;&lt;br&gt;service-a&amp;#160;&amp;#160; checkout iniciado&lt;br&gt;service-a&amp;#160;&amp;#160; HTTP Request: POST /inventory/reserve&lt;br&gt;service-b&amp;#160;&amp;#160; reserva solicitada&lt;br&gt;service-b&amp;#160;&amp;#160; reserva confirmada&lt;br&gt;service-a&amp;#160;&amp;#160; pedido confirmado&lt;br&gt;&lt;br&gt;&lt;i&gt;Los dos servicios, un solo trace_id.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b9cfe6;verticalAlign=top;align=left;fontSize=10;arcSize=8;spacingLeft=8;spacingTop=4;spacingRight=6;fontColor=#333333;" parent="col_logs" vertex="1">
          <mxGeometry x="14" y="186" width="402" height="132" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="&lt;b&gt;Como se logra&lt;/b&gt;&lt;br&gt;&lt;br&gt;LoggingInstrumentor con inject_trace_context agrega otelTraceID a cada LogRecord y el formateador propio lo escribe como trace_id.&lt;br&gt;&lt;br&gt;&lt;i&gt;En GCP se agrega ademas logging.googleapis.com/trace&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#4285f4;verticalAlign=top;align=left;fontSize=10;arcSize=8;spacingLeft=8;spacingTop=4;spacingRight=6;fontColor=#333333;dashed=1;" parent="col_logs" vertex="1">
          <mxGeometry x="14" y="332" width="402" height="122" as="geometry" />
        </mxCell>
