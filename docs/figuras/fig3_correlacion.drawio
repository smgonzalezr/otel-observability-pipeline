        <mxCell id="c1" value="Correlacion entre los tres pilares usando trace_id como pivote" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontSize=18;fontColor=#111111;fontStyle=1" parent="1" vertex="1">
