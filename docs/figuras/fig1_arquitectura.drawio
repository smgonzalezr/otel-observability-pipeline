        <mxCell id="c17" value="&lt;b&gt;spanmetrics&lt;/b&gt;&lt;br&gt;deriva tasa, error y duracion desde los spans&lt;br&gt;alimenta los SLI 1, 2 y 3 del dashboard&lt;br&gt;&lt;font color=&#39;#c0392b&#39;&gt;se ejecuta sobre el 100% de los spans&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontSize=10.5;fontColor=#333333;fontStyle=0" parent="connectors" vertex="1">
