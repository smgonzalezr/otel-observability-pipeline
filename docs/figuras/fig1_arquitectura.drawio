        <mxCell id="trazas" value="TRAZAS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e9e63;strokeWidth=2;verticalAlign=top;align=center;fontSize=13;fontStyle=1;fontColor=#2e9e63;arcSize=6;spacingTop=4;container=1;collapsible=0;" parent="fase3" vertex="1">
          <mxGeometry x="16" y="36" width="380" height="230" as="geometry" />
        </mxCell>
        <mxCell id="c20" value="&lt;b style=&quot;font-size: 12px;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot; color=&quot;#1a5fb4&quot;&gt;Jaeger UI (GCP)&lt;/font&gt;&lt;/b&gt;&lt;br style=&quot;font-size: 12px;&quot;&gt;vista de cascada de los 20 spans&lt;br style=&quot;font-size: 12px;&quot;&gt;&lt;br style=&quot;font-size: 12px;&quot;&gt;&lt;b style=&quot;font-size: 12px;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot; color=&quot;#b06a00&quot;&gt;AWS X-Ray o Tempo (AWS)&lt;/font&gt;&lt;/b&gt;&lt;br style=&quot;font-size: 12px;&quot;&gt;mismo trace_id en las dos nubes&lt;br style=&quot;font-size: 12px;&quot;&gt;&lt;br style=&quot;font-size: 12px;&quot;&gt;&lt;b style=&quot;font-size: 12px;&quot;&gt;Verificacion de propagacion&lt;/b&gt;&lt;br style=&quot;font-size: 12px;&quot;&gt;una traza, dos servicios, 20 spans&lt;br style=&quot;font-size: 12px;&quot;&gt;los spans de service-b cuelgan de los de service-a" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontSize=12;fontColor=#333333;fontStyle=0" parent="trazas" vertex="1">
          <mxGeometry x="12" y="34" width="356" height="184" as="geometry" />
        </mxCell>
        <mxCell id="metricas" value="METRICAS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e9e63;strokeWidth=2;verticalAlign=top;align=center;fontSize=13;fontStyle=1;fontColor=#2e9e63;arcSize=6;spacingTop=4;container=1;collapsible=0;" parent="fase3" vertex="1">
          <mxGeometry x="16" y="280" width="380" height="230" as="geometry" />
        </mxCell>
        <mxCell id="c21" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;Prometheus + Grafana&lt;/b&gt;&lt;br style=&quot;font-size: 13px;&quot;&gt;raspa el endpoint 8889 del Collector&lt;br style=&quot;font-size: 13px;&quot;&gt;y el 9464 de cada servicio&lt;br style=&quot;font-size: 13px;&quot;&gt;&lt;br style=&quot;font-size: 13px;&quot;&gt;&lt;b style=&quot;font-size: 13px;&quot;&gt;Dashboard de 6 paneles&lt;/b&gt;&lt;br style=&quot;font-size: 13px;&quot;&gt;4 SLI: rps, error, latencia, negocio&lt;br style=&quot;font-size: 13px;&quot;&gt;1 panel de CPU y memoria&lt;br style=&quot;font-size: 13px;&quot;&gt;1 panel de errores del Collector&lt;br style=&quot;font-size: 13px;&quot;&gt;&lt;br style=&quot;font-size: 13px;&quot;&gt;&lt;i style=&quot;font-size: 13px;&quot;&gt;dashboards/grafana-observabilidad.json&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontSize=13;fontColor=#333333;fontStyle=0" parent="metricas" vertex="1">
          <mxGeometry x="12" y="34" width="356" height="184" as="geometry" />
        </mxCell>
        <mxCell id="logs" value="LOGS y CORRELACION" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e9e63;strokeWidth=2;verticalAlign=top;align=center;fontSize=13;fontStyle=1;fontColor=#2e9e63;arcSize=6;spacingTop=4;container=1;collapsible=0;" parent="fase3" vertex="1">
          <mxGeometry x="16" y="524" width="380" height="250" as="geometry" />
        </mxCell>
        <mxCell id="c22" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;Destino&lt;/b&gt;&lt;br style=&quot;font-size: 13px;&quot;&gt;GCP: Cloud Logging · AWS: CloudWatch Logs · local: Loki&lt;br style=&quot;font-size: 13px;&quot;&gt;&lt;br style=&quot;font-size: 13px;&quot;&gt;&lt;b style=&quot;font-size: 13px;&quot;&gt;Pivote: el campo trace_id de cada linea JSON&lt;/b&gt;&lt;br style=&quot;font-size: 13px;&quot;&gt;Grafana lo convierte en un enlace con derivedFields, asi que desde un log se abre la traza y desde una traza se filtran sus logs.&lt;br style=&quot;font-size: 13px;&quot;&gt;&lt;br style=&quot;font-size: 13px;&quot;&gt;En GCP el campo logging.googleapis.com/trace hace lo mismo sin configurar nada." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontSize=13;fontColor=#333333;fontStyle=0" parent="logs" vertex="1">
          <mxGeometry x="12" y="34" width="356" height="204" as="geometry" />
        </mxCell>
        <mxCell id="c23" value="FASE 4. Analisis de overhead (medido)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf6f2;strokeColor=#8a4a1e;strokeWidth=2;verticalAlign=top;align=center;fontSize=14;fontStyle=1;fontColor=#8a4a1e;arcSize=6;spacingTop=4;container=1;collapsible=0;" parent="fase3" vertex="1">
          <mxGeometry x="412" y="36" width="348" height="738" as="geometry" />
        </mxCell>
        <mxCell id="c24" value="Escenario: 2 repeticiones, 8 usuarios concurrentes, 60 s por corrida, mediana.&lt;br&gt;&lt;br&gt;La latencia se mide desde el cliente, nunca con el instrumento evaluado." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontSize=10.5;fontColor=#333333;fontStyle=0" parent="c23" vertex="1">
