        </mxCell>
        <mxCell id="c18" value="&lt;b&gt;&lt;font color=&#39;#1a5fb4&#39;&gt;en GCP&lt;/font&gt;&lt;/b&gt;&lt;br&gt;otlp/jaeger &amp;#183; googlecloud&lt;br&gt;googlemanagedprometheus &amp;#183; prometheus (8889)&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&#39;#b06a00&#39;&gt;en AWS&lt;/font&gt;&lt;/b&gt;&lt;br&gt;awsxray &amp;#183; otlp/tempo &amp;#183; otlp/jaeger&lt;br&gt;awsemf &amp;#183; awscloudwatchlogs &amp;#183; prometheus&lt;br&gt;&lt;i&gt;Es lo unico que cambia entre las dos nubes.&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontSize=10.5;fontColor=#333333;fontStyle=0" parent="exporters" vertex="1">
          <mxGeometry x="12" y="30" width="324" height="140" as="geometry" />
        </mxCell>
        <mxCell id="c19" value="&lt;b&gt;Configuracion versionada&lt;/b&gt;&lt;br&gt;GCP: ConfigMap desde collector/otel-collector-gcp.yaml&lt;br&gt;AWS: SSM Parameter desde otel-collector-aws.yaml&lt;br&gt;&lt;i&gt;Los dos los crea Terraform con file(), no a mano.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0ecf9;strokeColor=#7a5cc4;verticalAlign=top;align=left;fontSize=10;arcSize=8;spacingLeft=8;spacingTop=4;spacingRight=6;fontColor=#333333;dashed=1;" parent="fase2" vertex="1">
