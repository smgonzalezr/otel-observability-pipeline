        </mxCell>
        <mxCell id="c46" value="&lt;b&gt;La palanca que sirve&lt;/b&gt;&lt;br&gt;&lt;br&gt;Cada peticion produce 20 spans. El costo no lo genera el agente sino ese volumen.&lt;br&gt;&lt;br&gt;Con muestreo de cabecera al 10 % los spans bajan 88,3 % y el throughput sube de 197 a 220 rps.&lt;br&gt;&lt;br&gt;La memoria casi no baja: cargar el SDK es un costo fijo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c58f6e;verticalAlign=top;align=left;fontSize=10;arcSize=8;spacingLeft=8;spacingTop=4;spacingRight=6;fontColor=#333333;" parent="c23" vertex="1">
          <mxGeometry x="14" y="296" width="320" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c47" value="&lt;b&gt;Lo que sigue&lt;/b&gt;&lt;br&gt;&lt;br&gt;Mover la decision al Collector con muestreo de cola, que conserva el 100 % de los errores porque decide con la traza ya completa.&lt;br&gt;&lt;br&gt;Los SLI no se afectan: salen de spanmetrics, antes del muestreo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c58f6e;verticalAlign=top;align=left;fontSize=10;arcSize=8;spacingLeft=8;spacingTop=4;spacingRight=6;fontColor=#333333;" parent="c23" vertex="1">
          <mxGeometry x="14" y="462" width="320" height="128" as="geometry" />
        </mxCell>
        <mxCell id="c48" value="&lt;i&gt;Datos en benchmark/results/benchmark_results.json. Se reproducen con &lt;b&gt;make benchmark&lt;/b&gt;.&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontSize=10;fontColor=#777777;fontStyle=0" parent="c23" vertex="1">
          <mxGeometry x="14" y="606" width="320" height="116" as="geometry" />
        </mxCell>
